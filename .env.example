# LLM provider configuration (Llama-family model, provider chosen in Phase 9)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://app_user:password@localhost:5432/db_analyst_agent

# Read-only role used for all agent-generated queries
READONLY_DATABASE_URL=postgresql+psycopg://readonly_user:password@localhost:5432/db_analyst_agent
