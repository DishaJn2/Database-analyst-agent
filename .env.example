# LLM provider configuration (open-weight LLM via Groq's free tier).
# Note: Llama chat models are not currently available on Groq (decommissioned) --
# see docs/architecture.md for the provider history. Using GPT-OSS-20B instead.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://app_user:password@localhost:5432/db_analyst_agent

# Read-only role used for all agent-generated queries
READONLY_DATABASE_URL=postgresql+psycopg://readonly_user:password@localhost:5432/db_analyst_agent
